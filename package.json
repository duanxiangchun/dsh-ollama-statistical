{
  "name": "dsh-ollama-statistical",
  "version": "0.6.8",
  "description": "DeepSeek Harness 插件：显示 Ollama Cloud 的 5 小时会话限额、周限额与官方请求量，并按供应商（provider）分类统计整个 DSH 的 token 用量（今天 / 本周周一开始 / 自定义日期，数据来自本机 DSH 会话日志），提供侧栏独立统计页与侧栏底部常驻双横条。Ollama Cloud session (5h) / weekly limits and official request counts, plus whole-DSH token usage broken down by provider (today / this week starting Monday / custom range from local session logs) for DeepSeek Harness, with a dedicated statistics page and persistent sidebar bars.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "connection",
        "timer",
        "locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      },
      "node": ">=20"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "ollama",
    "ollama-cloud",
    "usage",
    "quota",
    "token",
    "statistics",
    "web-ui",
    "zh",
    "en"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duanxiangchun/dsh-ollama-statistical.git"
  },
  "homepage": "https://github.com/duanxiangchun/dsh-ollama-statistical#readme",
  "bugs": {
    "url": "https://github.com/duanxiangchun/dsh-ollama-statistical/issues"
  }
}
