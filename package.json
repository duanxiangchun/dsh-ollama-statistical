{
  "name": "dsh-ollama-statistical",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：可视化 Ollama Cloud 的 5 小时会话限额与周限额，并统计该 API Key 的 token 用量（今天 / 本周周一开始 / 自定义日期，数据来自本机 DSH 会话日志），提供侧栏独立统计页与侧栏底部常驻双横条。Ollama Cloud session (5h) / weekly limits plus per-key token statistics for DeepSeek Harness: a dedicated statistics page (today / this week starting Monday / custom range from local session logs) and persistent sidebar bars.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "connection",
        "timer",
        "locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      },
      "node": ">=20"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "ollama",
    "ollama-cloud",
    "usage",
    "quota",
    "token",
    "statistics",
    "web-ui",
    "zh",
    "en"
  ],
  "license": "MIT"
}
